# ─────────────────────────────────────────────────────────
#  .gitignore — Bored Puzzle
# ─────────────────────────────────────────────────────────

# ── Environment & secrets ─────────────────────────────────
# Your real API key lives here — NEVER commit this
.env

# Generated by setup.js from .env — contains the real key
# at runtime, browser-readable but NOT git-tracked
config.js

# ── OS junk ──────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini

# ── Editor folders ────────────────────────────────────────
.vscode/
.idea/

# ── Logs ─────────────────────────────────────────────────
*.log
npm-debug.log*
